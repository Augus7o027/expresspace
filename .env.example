# Porta do servidor
PORT=3000
# Postgres (opcional). Sem isso, o servidor roda em memória (mensagens somem ao reiniciar).
# DATABASE_URL=postgres://user:pass@localhost:5432/comunidade
# Origem permitida pro CORS em dev (Vite)
CLIENT_ORIGIN=http://localhost:5173

# Contas e painel admin
# Primeiro admin (criado na primeira subida se ainda não houver nenhum)
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Augusto
# Assinatura das sessões (qualquer string longa e aleatória; sem isso, todo mundo desloga a cada restart)
SESSION_SECRET=gere-uma-string-aleatoria-longa
# Onde ficam state.json (sem Postgres) e o mapa enviado pelo painel. No Coolify, monte um volume aqui.
DATA_DIR=/app/data
# Tamanho máximo de upload na biblioteca (MB)
MAX_UPLOAD_MB=500

# Voz em rede fechada: TURN próprio (opcional; sem isso usa STUN do Google + relay público OpenRelay)
# TURN_URL=turn:turn.seudominio.com:3478
# TURN_USER=usuario
# TURN_PASS=senha

# Lembretes de aula por e-mail (opcional). Sem SMTP_URL, só push e aviso dentro do espaço.
# SMTP_URL=smtps://usuario:senha@smtp.seuprovedor.com:465
# MAIL_FROM=ExpresSpace <no-reply@seudominio.com>
# Push (Web Push): as chaves VAPID são geradas e guardadas sozinhas na primeira subida; defina só se quiser fixar
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# Fuso usado nos textos de lembrete
# TZ_DISPLAY=America/Sao_Paulo

# Aula ao vivo de verdade (LiveKit, SFU). Sem isso a voz vai em malha WebRTC (ok até ~8 pessoas por grupo).
# LIVEKIT_URL=wss://live.seudominio.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Gravação das aulas (LiveKit Egress -> bucket S3-compatível; vira aula na biblioteca quando termina)
# S3_BUCKET=expresspace
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_KEY=
# S3_SECRET=
# S3_PUBLIC_URL=https://media.seudominio.com   # URL pública do bucket (o vídeo é servido daqui)
# S3_PATH_STYLE=1                               # MinIO e alguns provedores precisam
